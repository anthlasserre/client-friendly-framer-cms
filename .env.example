# Framer Server API
# Generate at: Framer site settings → General → API keys
FRAMER_API_KEY=

# The full project URL or just its ID, e.g. https://framer.com/projects/Sites--aabbccdd1122
FRAMER_PROJECT_URL=

# Login credentials (single user). Both checked server-side.
AUTH_EMAIL=client@example.com
AUTH_PASSWORD=change-me

# Random ~32+ chars used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# UI language. Set per deployment; users can't switch it. Defaults to en.
# Supported values: en | fr
APP_LOCALE=en

# Brand name shown in the UI (browser title, sidebar, login description).
# When unset, the app uses the project name from the API automatically.
# APP_NAME=Acme Studio

# Public website URL — used for the sidebar "View site" link.
# When unset, the app uses the production publish URL from the API.
# WEBSITE_URL=https://acme.studio

# Optional: override cookie name (default: framer_cms_session)
# COOKIE_NAME=framer_cms_session
